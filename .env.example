# Copy to .env and fill in real values. Never commit .env.

# App
APP_NAME=Indian Stock Market Backend
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*

# Render (and Railway) inject their own $PORT automatically at runtime -
# nothing to set here for those. For local/docker-compose use, the default
# is 8000 (see Dockerfile and docker-compose.yml).

# Database
# Local/docker-compose:
DATABASE_URL=postgresql+asyncpg://stockapp:stockapp@localhost:5432/stockapp
# Neon/Supabase (managed Postgres) require TLS. Their dashboards hand you a
# connection string with "?sslmode=require" - that is the libpq/psycopg
# convention and asyncpg rejects it outright (TypeError: connect() got an
# unexpected keyword argument 'sslmode', verified against this app's asyncpg
# version). Rewrite the query string to "?ssl=require" instead, which asyncpg
# does understand, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?ssl=require

# NSE provider
NSE_BASE_URL=https://www.nseindia.com
NSE_REQUEST_TIMEOUT_SECONDS=15
NSE_MAX_RETRIES=3
NSE_RATE_LIMIT_PER_SECOND=3
NSE_COOKIE_TTL_SECONDS=300
NSE_CIRCUIT_FAIL_MAX=5
NSE_CIRCUIT_RESET_TIMEOUT_SECONDS=60

# Cache
# "memory" needs no external service - the safe default for a first
# deployment. Switch to "redis" (and set REDIS_URL to a managed Redis
# instance) once one is provisioned.
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_SEARCH_TTL_SECONDS=60
CACHE_QUOTE_TTL_SECONDS=15
CACHE_DASHBOARD_TTL_SECONDS=30

# Auth
# Generate a real value for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Scheduler
SCHEDULER_ENABLED=true
UNIVERSE_SYNC_HOUR_IST=8
UNIVERSE_SYNC_MINUTE_IST=0
PRICE_SYNC_HOUR_IST=18
PRICE_SYNC_MINUTE_IST=0
CORPORATE_ACTIONS_SYNC_HOUR_IST=7
CORPORATE_ACTIONS_SYNC_MINUTE_IST=30
FINANCIAL_RESULTS_SYNC_HOUR_IST=9
FINANCIAL_RESULTS_SYNC_MINUTE_IST=0
NEWS_SYNC_INTERVAL_MINUTES=30
ALERT_EVALUATION_INTERVAL_MINUTES=15
INDICATOR_SNAPSHOT_SYNC_HOUR_IST=18
INDICATOR_SNAPSHOT_SYNC_MINUTE_IST=30
IPO_SYNC_HOUR_IST=7
IPO_SYNC_MINUTE_IST=45
